# Cloudflare Pages response headers.
# styles.css and site.js are linked with a ?v= content hash (see tools/gen.py),
# so they can be cached for a year: every change gets a new URL.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/site.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/photos/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800

# Friction Forecast's ES modules import each other by plain URL (no content hash), so a browser
# holding an old areas.js next to a new app.js would break. Revalidate on every load (304 if unchanged).
/frictionforecast/*
  Cache-Control: public, max-age=0, must-revalidate
